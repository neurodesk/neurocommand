Bootstrap: docker
From: debian@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

%post
    export DEBIAN_FRONTEND=noninteractive
    rm /etc/apt/sources.list.d/debian.sources
    printf '%s\n' \
        'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261025T000000Z/ bookworm main' \
        'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261025T000000Z/ bookworm-updates main' \
        'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20261025T000000Z/ bookworm-security main' \
        > /etc/apt/sources.list
    apt-get update
    apt-get install -y --no-install-recommends \
        xvfb xauth x11-utils mesa-utils libgl1-mesa-dri libglx-mesa0
    rm -rf /var/lib/apt/lists/*
