FROM python:3.12-slim-bookworm

RUN mkdir -p /neurocommand
COPY neurodesk/requirements.txt /neurocommand/
WORKDIR /neurocommand

# Python 3.12 removed distutils, which neurodesk/build_menu.py imports; setuptools restores it.
RUN pip install --no-cache-dir -r requirements.txt

RUN python -c "import distutils.dir_util"
